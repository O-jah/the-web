# Payload
PAYLOAD_SECRET=change-me-to-a-long-random-string
DATABASE_URI=file:.ojah.db

# Public site URL (used for sitemaps, absolute links, emails)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: donation processor (Stripe, etc.) — wire up in src/app/(frontend)/donate/page.tsx
DONATE_URL=https://donate.example.org/ojah

# Outgoing email (SMTP) — used to send Contact form submissions.
# Any SMTP provider works: Gmail (with an App Password), SendGrid, Postmark, Resend SMTP, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=leetafere@gmail.com
SMTP_PASS=dejavu@2209
EMAIL_FROM="OJAH Website <leetafere@gmail.com>"

# Every Contact form submission is emailed to this address.
CONTACT_NOTIFICATION_EMAIL=leetafere@gmail.com
